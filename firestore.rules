rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /GiangVien/{idgv} {
      function validGiangVien(data) {
        return data.keys().hasAll(['IDGV', 'Fullname', 'Image', 'SumClass'])
          && data.keys().hasOnly(['IDGV', 'Fullname', 'Image', 'SumClass'])
          && data.IDGV is string
          && data.IDGV == idgv
          && data.Fullname is string
          && data.Fullname.size() > 0
          && data.Image is string
          && data.SumClass is int
          && data.SumClass >= 0;
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && validGiangVien(request.resource.data);
      allow delete: if request.auth != null;
    }
  }
}
